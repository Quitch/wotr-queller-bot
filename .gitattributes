# Auto detect text files and perform LF normalization
* text=auto

# Keep `git archive` to what `npm run build` needs (build.js, package.json, package-lock.json and src/) plus
# LICENSE and the README, which carries the build instructions.
# Everything else (linters, tests, docs, editor and CI configuration) is left out of the exported tree.
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
.markdownlint-cli2.jsonc export-ignore
.prettierignore export-ignore
.prettierrc.json export-ignore
.sonarlint/ export-ignore
.vscode/ export-ignore
CLAUDE.md export-ignore
CONTRIBUTING.md export-ignore
docs/ export-ignore
eslint.config.mjs export-ignore
scripts/ export-ignore
sonar-project.properties export-ignore
stylelint.config.mjs export-ignore
test/ export-ignore
